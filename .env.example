# Set in GitHub Actions secrets (NEVER commit a real key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# Set in GitHub Actions VARIABLES (not secret), use your real contact.
COLLECTOR_USER_AGENT=CrowdStageConferenceBot/1.0 (+mailto:contact@yourdomain.example)
MAX_SOURCES=100
